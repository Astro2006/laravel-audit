        { "name": "acme/unused-lib", "type": "library", "autoload": { "psr-4": { "Acme\\UnusedLib\\": "src/" } } },
        { "name": "acme/test-only", "type": "library", "autoload": { "psr-4": { "Acme\\TestOnly\\": "src/" } } },
        { "name": "acme/transitive-lib", "type": "library", "autoload": { "psr-4": { "Acme\\Transitive\\": "src/" } } },
        { "name": "acme/dev-tool", "type": "library", "autoload": { "psr-4": { "Acme\\DevTool\\": "src/" } }, "bin": ["bin/dev-tool"] },
        { "name": "guzzlehttp/psr7", "type": "library", "autoload": { "psr-4": { "GuzzleHttp\\Psr7\\": "src/" } } },
